{
  "$id": "/pkg/plugin/output/dns/config-schema.json",
  "title": "DNS output plugin",
  "type": "object",
  "required": [
    "Name",
    "ID",
    "Host"
  ],
  "properties": {
    "Name": {
      "const": "dns"
    },
    "ID": {
      "type": "string"
    },
    "Host": {
      "type": "string",
      "description": "The host and port of the DNS server to send logs to.",
      "examples": [
        "192.168.0.1:53",
        "[2001:db8::1]:53"
      ]
    },
    "Timeout": {
      "type": "string",
      "description": "The timeout for sending logs to the DNS server.",
      "default": "1s"
    },
    "HTTPConfig": {
      "type": "object",
      "properties": {
        "Path": {
          "type": "string",
          "description": "The HTTP Path to send logs to.",
          "default": "/dns-query"
        },
        "Method": {
          "type": "string",
          "description": "The HTTP Method to use.",
          "enum": [
            "POST",
            "GET"
          ],
          "default": "POST"
        },
        "TLS": {
          "type": "boolean",
          "description": "Whether to use TLS or not.",
          "default": true
        }
      }
    },
    "Protocol": {
      "type": "string",
      "enum": [
        "udp",
        "tcp",
        "tls",
        "https"
      ],
      "default": "udp"
    }
  }
}