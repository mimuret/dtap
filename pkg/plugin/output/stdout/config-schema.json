{
  "$id": "/pkg/plugin/output/stdout/config-schema.json",
  "title": "stdout output plugin",
  "type": "object",
  "required": [
    "Name",
    "ID",
    "Format"
  ],
  "properties": {
    "Name": {
      "const": "stdout"
    },
    "ID": {
      "type": "string"
    },
    "Format": {
      "description": "The `Format` is the output format.",
      "type": "string",
      "enum": [
        "json/v1",
        "go-template"
      ]
    },
    "Template": {
      "description": "The `Template` is the `text/template` style template string.",
      "type": "string"
    }
  }
}