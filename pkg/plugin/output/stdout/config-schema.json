{
  "$id": "/pkg/plugin/output/stdout/config-schema.json",
  "title": "stdout output plugin",
  "type": "object",
  "required": [
    "Name",
    "ID",
    "Format"
  ],
  "properties": {
    "Name": {
      "const": "stdout"
    },
    "ID": {
      "type": "string"
    },
    "Format": {
      "$ref": "/schemas/schema.json#/$defs/OutputTextFormat"
    },
    "OutputFilters": {
      "$ref": "/schemas/schema.json#/$defs/OutputFilters"
    },
    "Template": {
      "description": "The `Template` is the `text/template` style template string.",
      "type": "string"
    }
  }
}