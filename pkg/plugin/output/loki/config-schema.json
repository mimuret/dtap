{
  "$id": "/pkg/plugin/output/loki/config-schema.json",
  "title": "loki output plugin",
  "type": "object",
  "description": "see: https://grafana.com/docs/loki/latest/clients/promtail/configuration/#clients",
  "required": [
    "Name",
    "ID",
    "URL"
  ],
  "properties": {
    "Name": {
      "const": "nats"
    },
    "ID": {
      "type": "string"
    },
    "URL": {
      "description": "The `URL` is the promtail push API URL.",
      "type": "string"
    },
    "MaxStream": {
      "description": "The `MaxStream` is the number of promtail stream.",
      "type": "integer"
    },
    "OutputFilters": {
      "$ref": "/schemas/schema.json#/$defs/OutputFilters"
    }
  }
}