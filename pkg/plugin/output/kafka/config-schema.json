{
  "$id": "/pkg/plugin/output/kafka/config-schema.json",
  "title": "kafka output plugin",
  "type": "object",
  "required": [
    "Name",
    "ID",
    "KafkaConfig"
  ],
  "properties": {
    "Name": {
      "const": "kafka"
    },
    "ID": {
      "type": "string"
    },
    "KafkaConfig": {
      "$ref": "#/$defs/KafkaConfig"
    }
  },
  "$defs": {
    "KafkaConfig": {
      "title": "kafka output setting",
      "description": "KafkaConfig is kafka connect config",
      "type": "object",
      "properties": {
        "Hosts": {
          "description": "Hosts are host:port to connect.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "SchemaRegistries": {
          "description": "SchemaRegistries are host:port to connect registry server.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "Retry": {
          "description": "Retry is the number of retry publish.",
          "type": "integer",
          "minimum": 0
        },
        "Topic": {
          "description": "Topic is the kafka topic.",
          "type": "string"
        },
        "Key": {
          "description": "Topic is the kafka message key.",
          "type": "string"
        },
        "OutputType": {
          "description": "OutputType is output format.",
          "type": "string",
          "enum": [
            "json",
            "protobuf",
            "avero"
          ]
        },
        "OutputFilters": {
          "$ref": "https://github.com/mimuret/dtap/raw/refs/heads/v2/schemas/types.json#/$defs/OutputFilters"
        }    
      }
    }
  }
}