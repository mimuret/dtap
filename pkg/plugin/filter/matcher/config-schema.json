{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "/pkg/plugin/filter/matcher/config-schema.json",
  "title": "matcher filter plugin",
  "description": "The `matcher` is the filter plugin that filters DNSTAP message using rules.",
  "type": "object",
  "required": [
    "Name",
    "Rule"
  ],
  "properties": {
    "Name": {
      "const": "matcher"
    },
    "Rule": {
      "description": "The `Rule` is the rule set. see https://pkg.go.dev/github.com/mimuret/dnsutils/matcher#Config",
      "$ref": "#/$defs/ConfigSet"
    }
  },
  "$defs": {
    "ConfigSet": {
      "title": "ConfigSet",
      "type": "object",
      "required": [
        "Op"
      ],
      "properties": {
        "Op": {
          "type": "string",
          "enum": [
            "AND",
            "OR"
          ]
        },
        "Matchers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MatcherConfig"
          }
        },
        "SubConfigs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConfigSet"
          }
        }
      }
    },
    "MatcherConfig": {
      "title": "MatcherConfig",
      "type": "object",
      "required": [
        "Type",
        "Name",
        "Arg"
      ],
      "properties": {
        "Type": {
          "type": "string",
          "enum": [
            "DNS",
            "DNSTAP"
          ]
        },
        "Name": {
          "type": "string"
        },
        "Arg": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    }
  }
}
