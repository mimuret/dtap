{
  "$id": "/pkg/plugin/filter/iphash/config-schema.json",
  "title": "iphash filter plugin",
  "description": "The `iphash` is the filter plugin that adds hashed address to the label. ",
  "type": "object",
  "required": [
    "Name",
    "ID",
    "Salt"
  ],
  "properties": {
    "Name": {
      "const": "iphash"
    },
    "ID": {
      "type": "string"
    },
    "Salt": {
      "description": "The `string` is the hash salt.",
      "type": "string"
    },
    "QueryAddressEnabled": {
      "description": "Enable hash creation from QueryAddress.",
      "type": "boolean",
      "default": true
    },
    "ResponseAddressEnabled": {
      "description": "Enable hash creation from ResponseAddress.",
      "type": "boolean",
      "default": true
    }
  }
}