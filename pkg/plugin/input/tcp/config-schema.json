{
  "$id": "/pkg/plugin/input/tcp/config-schema.json",
  "title": "tcp input plugin",
  "type": "object",
  "required": [
    "Name",
    "ID",
    "Port"
  ],
  "properties": {
    "Name": {
      "const": "tcp"
    },
    "ID": {
      "type": "string"
    },
    "Address": {
      "type": "string"
    },
    "Port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "Format": {
      "$ref": "https://github.com/mimuret/dtap/raw/refs/heads/v2/schemas/types.json#/$defs/OutputBinFormat"
    }
  }
}