{
  "InputFilterWorkerNum": 1,
  "LogLevel": "info",
  "MetricsListen": ":9520",
  "InputBufferConfig": {
    "Name": "input_common",
    "Size": 100
  },
  "Input": [
    {
      "Name": "unix",
      "Path": "/var/run/unbound/dnstap.sock",
      "User": "unbound"
    }
  ],
  "Filter": [
    {
      "Name": "grep",
      "Rules": {
        "Op": "AND",
        "Matchers": [
          {
            "Type": "DNS",
            "Name": "qname",
            "Arg": "www.example.jp"
          }
        ]
      }
    }
  ],
  "OutputGroup": [
    {
      "Filter": [
        {
          "Name": "grep",
          "Rules": {
            "Op": "AND",
            "Matchers": [
              {
                "Type": "DNS",
                "Name": "qtype",
                "Arg": "A"
              }
            ]
          }
        }
      ],
      "Outputs": [
        {
          "Name": "nop"
        },
        {
          "Name": "nop"
        }
      ]
    }
  ]
}